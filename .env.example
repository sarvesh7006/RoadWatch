# ==============================================================================
# RoadWatch - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
#
# Note: Real .env files, credentials, and secrets are excluded from Git by .gitignore.
# ==============================================================================

# Server Port
# Port on which the FastAPI application and dashboard listen. Default: 8011
PORT=8011

# Machine Learning Model Configuration
# Relative or absolute path to the YOLOv8 model weights checkpoint.
# Default: models/pothole.pt (verified pretrained checkpoint included in repository)
MODEL_PATH=models/pothole.pt

# Inference Device
# Device to run YOLOv8 inference: 'cpu', 'mps' (Apple Silicon), or '0' (NVIDIA CUDA)
# Default: cpu
YOLO_DEVICE=cpu

# Data & Persistence Directories
# Directory for local SQLite database, uploaded images, and cache
DATA_DIR=data
YOLO_CONFIG_DIR=data/yolo
MPLCONFIGDIR=data/matplotlib

# Database URL
# Default: SQLite file in the data directory
DATABASE_URL=sqlite:///data/roadwatch.db
# PostgreSQL / PostGIS alternative (uncomment when using external PostgreSQL or compose):
# DATABASE_URL=postgresql+psycopg://roadwatch:roadwatch@127.0.0.1:5432/roadwatch

# Testing Settings
# Set to 1 to run opt-in real inference regression tests with pytest
RUN_MODEL_TESTS=0
